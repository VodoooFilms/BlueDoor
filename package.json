{
  "name": "belegal-local-demo",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json",
    "release:mac": "python3 scripts/release-mac.py",
    "release:mac:dev": "BELEGAL_LOCAL_DEMO_RELEASE_MODE=development python3 scripts/release-mac.py",
    "release:windows:arm64": "powershell -ExecutionPolicy Bypass -File scripts/release-windows.ps1 -Architecture arm64",
    "release:windows:x64": "powershell -ExecutionPolicy Bypass -File scripts/release-windows.ps1 -Architecture x64",
    "prepare:runtime": "python3 scripts/build-ffmpeg.py && python3 scripts/collect-notices.py",
    "demo:mac": "python3 scripts/build-local-demo.py",
    "test:privacy:ui": "node tests/run-ui.mjs --privacy",
    "check": "pnpm typecheck && pnpm build",
    "test:ui": "node tests/run-ui.mjs",
    "test:native": "cargo test --manifest-path src-tauri/Cargo.toml --lib",
    "check:native": "cargo fmt --manifest-path src-tauri/Cargo.toml --check && cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings",
    "test:workspace:ui": "node tests/run-ui.mjs --workspace",
    "test:layout:ui": "node tests/run-ui.mjs --layout"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@tauri-apps/cli": "^2.0.0",
    "playwright": "1.63.0",
    "svelte": "^5.57.0",
    "svelte-check": "^4.7.6",
    "typescript": "~5.6.3",
    "vite": "^6.0.0"
  },
  "packageManager": "pnpm@12.3.4"
}
